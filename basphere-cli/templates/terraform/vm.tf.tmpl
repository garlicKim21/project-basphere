# Basphere VM Terraform Configuration
# 자동 생성됨 - 직접 수정하지 마세요
#
# VM: ${VM_NAME}
# vSphere VM Name: ${VSPHERE_VM_NAME}
# User: ${USER}
# Created: ${TIMESTAMP}

terraform {
  required_version = ">= 1.0.0"

  required_providers {
    vsphere = {
      source  = "hashicorp/vsphere"
      version = "~> 2.0"
    }
  }
}

# vSphere Provider 설정
# 인증 정보는 환경변수로 주입됨 (VSPHERE_USER, VSPHERE_PASSWORD)
provider "vsphere" {
  vsphere_server       = var.vsphere_server
  allow_unverified_ssl = var.vsphere_allow_unverified_ssl
}

# ============================================
# Variables
# ============================================

variable "vsphere_server" {
  description = "vCenter server address"
  type        = string
  default     = "${VSPHERE_SERVER}"
}

variable "vsphere_allow_unverified_ssl" {
  description = "Allow unverified SSL certificates"
  type        = bool
  default     = ${VSPHERE_ALLOW_UNVERIFIED_SSL}
}

variable "datacenter" {
  description = "vSphere datacenter name"
  type        = string
  default     = "${DATACENTER}"
}

variable "cluster" {
  description = "vSphere cluster name"
  type        = string
  default     = "${CLUSTER}"
}

variable "datastore" {
  description = "vSphere datastore name"
  type        = string
  default     = "${DATASTORE}"
}

variable "network" {
  description = "vSphere network (port group) name"
  type        = string
  default     = "${NETWORK}"
}

variable "resource_pool" {
  description = "vSphere resource pool path"
  type        = string
  default     = "${RESOURCE_POOL}"
}

variable "content_library" {
  description = "Content library name (OS image source)"
  type        = string
  default     = "${CONTENT_LIBRARY}"
}

variable "library_item" {
  description = "Content library item name (OS image)"
  type        = string
  default     = "${LIBRARY_ITEM}"
}

variable "guest_id" {
  description = "vSphere guest OS identifier"
  type        = string
  default     = "${GUEST_ID}"
}

variable "firmware" {
  description = "VM firmware (bios or efi)"
  type        = string
  default     = "${FIRMWARE}"
}

variable "base_folder" {
  description = "Base VM folder path"
  type        = string
  default     = "${VM_FOLDER}"
}

variable "vm_name" {
  description = "VM name (short, for display and hostname)"
  type        = string
  default     = "${VM_NAME}"
}

variable "vsphere_vm_name" {
  description = "vSphere VM name (with user prefix, globally unique)"
  type        = string
  default     = "${VSPHERE_VM_NAME}"
}

variable "num_cpus" {
  description = "Number of CPUs"
  type        = number
  default     = ${NUM_CPUS}
}

variable "memory" {
  description = "Memory in MB"
  type        = number
  default     = ${MEMORY_MB}
}

variable "disk_size" {
  description = "Disk size in GB"
  type        = number
  default     = ${DISK_GB}
}

variable "ip_address" {
  description = "Static IP address"
  type        = string
  default     = "${IP_ADDRESS}"
}

variable "netmask" {
  description = "Network mask"
  type        = string
  default     = "${NETMASK}"
}

variable "gateway" {
  description = "Default gateway"
  type        = string
  default     = "${GATEWAY}"
}

variable "dns_servers" {
  description = "DNS servers"
  type        = list(string)
  default     = [${DNS_SERVERS}]
}

variable "ssh_public_key" {
  description = "SSH public key for default user"
  type        = string
  default     = "${SSH_PUBLIC_KEY}"
}

variable "owner" {
  description = "VM owner (basphere user)"
  type        = string
  default     = "${USER}"
}

variable "mtu" {
  description = "Network MTU size"
  type        = number
  default     = ${MTU}
}

variable "interface" {
  description = "Network interface name (OS-specific)"
  type        = string
  default     = "${INTERFACE}"
}

variable "extra_disks" {
  description = "Extra disks: size in GB, mode auto(format+mount) or raw"
  type = list(object({
    size = number
    mode = string
  }))
  default = ${EXTRA_DISKS}
}

variable "extra_networks" {
  description = "Extra network port groups (link only, no IP configuration)"
  type        = list(string)
  default     = ${EXTRA_NETWORKS}
}

# ============================================
# Data Sources
# ============================================

data "vsphere_datacenter" "dc" {
  name = var.datacenter
}

data "vsphere_compute_cluster" "cluster" {
  name          = var.cluster
  datacenter_id = data.vsphere_datacenter.dc.id
}

data "vsphere_datastore" "datastore" {
  name          = var.datastore
  datacenter_id = data.vsphere_datacenter.dc.id
}

data "vsphere_network" "network" {
  name          = var.network
  datacenter_id = data.vsphere_datacenter.dc.id
}

data "vsphere_content_library" "os" {
  name = var.content_library
}

data "vsphere_content_library_item" "os_image" {
  name       = var.library_item
  library_id = data.vsphere_content_library.os.id
  type       = "ovf"
}

# 추가 네트워크 존재 검증용 (VM 생성 전에 잘못된 포트그룹을 조기 발견)
data "vsphere_network" "extra" {
  for_each      = toset(var.extra_networks)
  name          = each.value
  datacenter_id = data.vsphere_datacenter.dc.id
}

# ============================================
# cloud-init configuration
# ============================================

locals {
  # VM이 생성될 폴더 경로 (폴더는 사용자 생성 시 이미 만들어짐)
  vm_folder_path = "${var.base_folder}/${var.owner}"

  # cloud-init metadata with network configuration
  # 인터페이스 이름은 OS별로 다름 (Ubuntu: ens192, Rocky: ens33)
  metadata = <<-META
    instance-id: ${var.vsphere_vm_name}
    local-hostname: ${var.vm_name}
    network:
      version: 2
      ethernets:
        ${var.interface}:
          dhcp4: false
          mtu: ${var.mtu}
          addresses:
            - ${var.ip_address}/${NETWORK_PREFIX}
          gateway4: ${var.gateway}
          nameservers:
            addresses: ${jsonencode(var.dns_servers)}
  META

  # 추가 디스크 중 자동 마운트(auto) 디스크의 게스트 디바이스/마운트 경로
  # 추가 디스크 N은 SCSI unit N → /dev/sd{b,c,...}, 마운트 경로는 /dataN
  auto_disks = [
    for idx, d in var.extra_disks : {
      device = "/dev/sd${substr("abcdefgh", idx + 1, 1)}"
      mount  = "/data${idx + 1}"
    } if d.mode == "auto"
  ]

  # cloud-init userdata
  # hostname은 짧은 이름 사용
  userdata_base = {
    hostname         = var.vm_name
    manage_etc_hosts = true
    users = [
      {
        name                = "${USER}"
        sudo                = "ALL=(ALL) NOPASSWD:ALL"
        shell               = "/bin/bash"
        ssh_authorized_keys = [var.ssh_public_key]
      }
    ]
    package_update  = false
    package_upgrade = false
    growpart = {
      mode                     = "auto"
      devices                  = ["/"]
      ignore_growroot_disabled = false
    }
    runcmd = [
      "echo \"Basphere VM ${var.vsphere_vm_name} (${var.vm_name}) initialized\" > /var/log/basphere-init.log",
      "echo \"Owner: ${var.owner}\" >> /var/log/basphere-init.log",
      "echo \"IP: ${var.ip_address}\" >> /var/log/basphere-init.log",
    ]
    final_message = "Basphere VM is ready after $UPTIME seconds"
  }

  # auto 디스크는 cloud-init으로 GPT 파티션 + ext4 포맷 후 마운트 (nofail: 디스크 없어도 부팅 지속)
  # auto 디스크가 없으면 빈 컬렉션이 되며 cloud-init이 무시함
  userdata_disks = {
    disk_setup = {
      for d in local.auto_disks : d.device => {
        table_type = "gpt"
        layout     = true
        overwrite  = false
      }
    }
    fs_setup = [
      for d in local.auto_disks : {
        device     = d.device
        partition  = "auto"
        filesystem = "ext4"
        overwrite  = false
      }
    ]
    mounts = [
      for d in local.auto_disks : ["${d.device}1", d.mount, "ext4", "defaults,nofail", "0", "2"]
    ]
  }

  userdata = join("\n", ["#cloud-config", yamlencode(merge(local.userdata_base, local.userdata_disks))])
}

# ============================================
# VM Resource
# ============================================

resource "vsphere_virtual_machine" "vm" {
  # vSphere에서 보이는 이름 (사용자 프리픽스 포함)
  name             = var.vsphere_vm_name
  resource_pool_id = data.vsphere_compute_cluster.cluster.resource_pool_id
  datastore_id     = data.vsphere_datastore.datastore.id

  # 사용자별 폴더에 생성
  folder           = local.vm_folder_path

  num_cpus = var.num_cpus
  memory   = var.memory

  # 라이브러리 OVF 아이템에서는 하드웨어 정보를 읽을 수 없어 config에서 명시
  guest_id = var.guest_id
  firmware = var.firmware

  scsi_type = "pvscsi"

  network_interface {
    network_id   = data.vsphere_network.network.id
    adapter_type = "vmxnet3"
  }

  disk {
    label            = "disk0"
    size             = var.disk_size
    thin_provisioned = true
    eagerly_scrub    = false
  }

  # 추가 디스크 (고급 옵션)
  dynamic "disk" {
    for_each = var.extra_disks
    content {
      label            = "disk${disk.key + 1}"
      size             = disk.value.size
      unit_number      = disk.key + 1
      thin_provisioned = true
      eagerly_scrub    = false
    }
  }

  # vApp properties 전달을 위한 CDROM 장치
  cdrom {
    client_device = true
  }

  clone {
    # 컨텐츠 라이브러리 OVF 아이템에서 직접 배포
    template_uuid = data.vsphere_content_library_item.os_image.id
    # vSphere customization 대신 cloud-init 사용 (Cloud Image 호환)
  }

  # cloud-init via VMware guestinfo
  # Ubuntu 24.04+: network 설정은 metadata 안에 포함됨 (guestinfo.network 별도 사용 안 함)
  extra_config = {
    "guestinfo.metadata"          = base64encode(local.metadata)
    "guestinfo.metadata.encoding" = "base64"
    "guestinfo.userdata"          = base64encode(local.userdata)
    "guestinfo.userdata.encoding" = "base64"
  }

  # Custom attributes (태그)
  tags = []

  lifecycle {
    ignore_changes = [
      extra_config["guestinfo.userdata"],
      extra_config["guestinfo.metadata"],
    ]
  }

}

# ============================================
# 추가 네트워크 (고급 옵션)
# ============================================
# OVF 라이브러리 배포는 NIC 하드웨어 커스터마이징을 지원하지 않으므로(VMware 제약)
# VM 생성 완료 후 govc로 hot-add한다. IP는 미설정(링크만 연결).
# NIC은 VM에 귀속되어 VM 삭제 시 함께 제거된다.

resource "terraform_data" "extra_nic" {
  count = length(var.extra_networks)

  triggers_replace = [vsphere_virtual_machine.vm.id, var.extra_networks[count.index]]

  provisioner "local-exec" {
    # 인증은 terraform 프로세스 환경변수(VSPHERE_USER/PASSWORD)를 셸에서 그대로 사용
    command = "GOVC_USERNAME=\"$${VSPHERE_USER}\" GOVC_PASSWORD=\"$${VSPHERE_PASSWORD}\" govc vm.network.add -vm \"${var.vsphere_vm_name}\" -net \"${var.extra_networks[count.index]}\" -net.adapter vmxnet3"
    environment = {
      GOVC_URL        = "https://${var.vsphere_server}"
      GOVC_INSECURE   = var.vsphere_allow_unverified_ssl ? "1" : "0"
      GOVC_DATACENTER = var.datacenter
    }
  }
}

# ============================================
# Outputs
# ============================================

output "vm_name" {
  description = "VM name (short)"
  value       = var.vm_name
}

output "vsphere_vm_name" {
  description = "vSphere VM name (with prefix)"
  value       = vsphere_virtual_machine.vm.name
}

output "vm_id" {
  description = "VM ID"
  value       = vsphere_virtual_machine.vm.id
}

output "ip_address" {
  description = "VM IP address"
  value       = var.ip_address
}

output "owner" {
  description = "VM owner"
  value       = var.owner
}

output "folder" {
  description = "VM folder path"
  value       = local.vm_folder_path
}
