#!/bin/bash
#
# VM 생성 스크립트 (사용자용)
#
# 사용법: create-vm [옵션]
#
# 일반 모드: API 서버를 통해 VM 생성
# API 모드 (--api): 직접 Terraform 실행 (API 서버에서 호출)
#

set -euo pipefail

# 공통 라이브러리 로드
source /usr/local/lib/basphere/common.sh 2>/dev/null || {
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    source "$SCRIPT_DIR/../../lib/common.sh"
}

# 내부 스크립트 경로
INTERNAL_SCRIPTS="/usr/local/lib/basphere/internal"
if [[ ! -d "$INTERNAL_SCRIPTS" ]]; then
    INTERNAL_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../internal"
fi

# 템플릿 경로
TEMPLATE_DIR="/var/lib/basphere/templates/terraform"
if [[ ! -d "$TEMPLATE_DIR" ]]; then
    TEMPLATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../templates/terraform"
fi

# 현재 사용자
CURRENT_USER=$(get_current_user)

# 사용법
usage() {
    cat << EOF
VM 생성

사용법: create-vm [옵션]

옵션:
  -n, --name <name>     VM 이름 (대화형 입력 가능)
  -o, --os <os>         OS 종류 (ubuntu-24.04, rocky-10)
  -s, --spec <spec>     스펙 (small, medium, large)
  -c, --count <count>   생성할 VM 수 (기본값: 1)
  --disk <GB[:auto|raw]>  추가 디스크 (반복 가능, 기본 auto=포맷+마운트)
  --nic <network>       추가 네트워크 연결 (반복 가능, IP 미설정)
  -h, --help            도움말

예시:
  create-vm                                    # 대화형 모드
  create-vm -n my-server -o ubuntu-24.04 -s medium   # 명령행 모드
  create-vm -n web -o rocky-10 -s small -c 3         # 3대 생성
  create-vm -n db -o ubuntu-24.04 -s large --disk 200 --disk 50:raw --nic 98-air-gapped
EOF
    exit 0
}

# OS 목록 가져오기
get_os_list() {
    yq eval '.templates.os | keys | .[]' "$BASPHERE_CONFIG" 2>/dev/null
}

# OS 설명 가져오기
get_os_description() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].description" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "$os"
    else
        echo "$value"
    fi
}

# OS 라이브러리 아이템 이름 가져오기 (컨텐츠 라이브러리 기반)
get_os_library_item() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].library_item" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo ""
    else
        echo "$value"
    fi
}

# OS 게스트 ID 가져오기
get_os_guest_id() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].guest_id" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "otherLinux64Guest"
    else
        echo "$value"
    fi
}

# OS 펌웨어 가져오기
get_os_firmware() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].firmware" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "bios"
    else
        echo "$value"
    fi
}

# OS 기본 사용자 가져오기
get_os_default_user() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].default_user" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "ubuntu"
    else
        echo "$value"
    fi
}

# OS 네트워크 인터페이스 이름 가져오기
get_os_interface() {
    local os="$1"
    local value
    value=$(yq eval ".templates.os[\"$os\"].interface" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "ens192"  # 기본값
    else
        echo "$value"
    fi
}

# OS 유효성 검사
validate_os() {
    local os="$1"
    local library_item
    library_item=$(get_os_library_item "$os")
    [[ -n "$library_item" ]]
}

# VM 스펙 목록 가져오기
get_vm_specs() {
    local specs_file="/etc/basphere/specs.yaml"

    if [[ ! -f "$specs_file" ]]; then
        echo "small medium large"
        return
    fi

    yq eval '.vm_specs | keys | .[]' "$specs_file" 2>/dev/null | tr '\n' ' '
}

# 스펙 상세 정보 가져오기
get_spec_details() {
    local spec="$1"
    local cpu memory disk description

    cpu=$(get_spec ".vm_specs.$spec.cpu" "2")
    memory=$(get_spec ".vm_specs.$spec.memory_mb" "4096")
    disk=$(get_spec ".vm_specs.$spec.disk_gb" "50")
    description=$(get_spec ".vm_specs.$spec.description" "")

    local memory_gb=$((memory / 1024))
    echo "$cpu vCPU, ${memory_gb}GB RAM, ${disk}GB Disk"
}

# ============================================
# 고급 옵션 (추가 디스크/네트워크)
# ============================================

# 전역: "SIZE:MODE" 항목 배열 / 네트워크 카탈로그 키 배열
EXTRA_DISKS=()
EXTRA_NICS=()

# 콘솔 전용 관리자 계정 (vSphere 웹 콘솔 비번 로그인용)
CONSOLE_ADMIN_USER="bsadmin"
# 관리자 비번 저장 위치 (root 전용)
CONSOLE_PW_DIR="$BASPHERE_DATA_DIR/console-passwords"
# 렌더링 시점에 채워지는 해시 (create_single_vm_api_mode에서 설정)
ADMIN_PASSWORD_HASH=""

# 추가 네트워크 카탈로그 키 목록
get_network_catalog() {
    yq eval '.extra_network_catalog | keys | .[]' "$BASPHERE_CONFIG" 2>/dev/null
}

# 카탈로그 키 → vSphere 포트그룹 이름
get_network_port_group() {
    local name="$1"
    local value
    value=$(yq eval ".extra_network_catalog[\"$name\"].port_group" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo ""
    else
        echo "$value"
    fi
}

get_network_catalog_description() {
    local name="$1"
    local value
    value=$(yq eval ".extra_network_catalog[\"$name\"].description" "$BASPHERE_CONFIG" 2>/dev/null)
    if [[ -z "$value" || "$value" == "null" ]]; then
        echo "$name"
    else
        echo "$value"
    fi
}

# 추가 디스크 항목("SIZE:MODE") 검증
validate_extra_disk() {
    local entry="$1"
    local size="${entry%%:*}"
    local mode="${entry##*:}"
    local min_gb max_gb
    min_gb=$(get_spec ".custom_options.extra_disks.min_gb" "10")
    max_gb=$(get_spec ".custom_options.extra_disks.max_gb" "500")

    if ! [[ "$size" =~ ^[0-9]+$ ]]; then
        log_error "추가 디스크 크기는 숫자여야 합니다: $entry"
        return 1
    fi
    if (( size < min_gb || size > max_gb )); then
        log_error "추가 디스크 크기는 ${min_gb}~${max_gb}GB 범위여야 합니다: ${size}GB"
        return 1
    fi
    if [[ "$mode" != "auto" && "$mode" != "raw" ]]; then
        log_error "추가 디스크 모드는 auto 또는 raw여야 합니다: $entry"
        return 1
    fi
    return 0
}

# 고급 옵션 전체 검증 (플래그/API 모드 공용, 권위 검증)
validate_extra_options() {
    local max_disks max_nics
    max_disks=$(get_spec ".custom_options.extra_disks.max_count" "3")
    max_nics=$(get_spec ".custom_options.extra_networks.max_count" "1")

    if (( ${#EXTRA_DISKS[@]} > max_disks )); then
        log_error "추가 디스크는 최대 ${max_disks}개까지 가능합니다"
        return 1
    fi
    local d
    for d in "${EXTRA_DISKS[@]}"; do
        validate_extra_disk "$d" || return 1
    done

    if (( ${#EXTRA_NICS[@]} > max_nics )); then
        log_error "추가 네트워크는 최대 ${max_nics}개까지 가능합니다"
        return 1
    fi
    local n pg
    for n in "${EXTRA_NICS[@]}"; do
        pg=$(get_network_port_group "$n")
        if [[ -z "$pg" ]]; then
            log_error "허용되지 않은 네트워크입니다: $n"
            log_info "사용 가능한 네트워크: $(get_network_catalog | tr '\n' ' ')"
            return 1
        fi
    done
    return 0
}

# 사용자 SSH 공개키 가져오기
get_user_ssh_key() {
    local user="$1"
    local ssh_key_file="/home/$user/.ssh/authorized_keys"

    if [[ -f "$ssh_key_file" ]]; then
        head -1 "$ssh_key_file"
    else
        log_warn "SSH 공개키를 찾을 수 없습니다"
        echo ""
    fi
}

# Terraform 파일 생성
generate_terraform_file() {
    local vm_name="$1"
    local os_type="$2"
    local spec="$3"
    local ip_address="$4"
    local user="$5"
    local output_dir="$6"

    local template_file="$TEMPLATE_DIR/vm.tf.tmpl"

    if [[ ! -f "$template_file" ]]; then
        log_error "Terraform 템플릿을 찾을 수 없습니다: $template_file"
        return 1
    fi

    # 설정 값 로드
    local vsphere_server datacenter cluster datastore network resource_pool vm_folder default_user
    vsphere_server=$(get_config '.vsphere.server' 'vcenter.example.local')
    datacenter=$(get_config '.vsphere.datacenter' 'DC1')
    cluster=$(get_config '.vsphere.cluster' 'Cluster1')
    datastore=$(get_config '.vsphere.datastore' 'datastore1')
    network=$(get_config '.vsphere.network' 'VM Network')
    resource_pool=$(get_config '.vsphere.resource_pool' '/DC1/host/Cluster1/Resources')
    vm_folder=$(get_config '.vsphere.folder' 'basphere-vms')

    # OS별 설정 (컨텐츠 라이브러리 기반)
    local content_library library_item guest_id firmware interface
    content_library=$(get_config '.templates.library' 'os-content-library')
    library_item=$(get_os_library_item "$os_type")
    guest_id=$(get_os_guest_id "$os_type")
    firmware=$(get_os_firmware "$os_type")
    default_user=$(get_os_default_user "$os_type")
    interface=$(get_os_interface "$os_type")

    # 네트워크 설정
    local gateway netmask dns_servers network_prefix mtu
    gateway=$(get_config '.network.gateway' '10.254.0.1')
    netmask=$(get_config '.network.netmask' '255.255.248.0')
    network_prefix=$(get_config '.network.prefix_length' '21')
    mtu=$(get_config '.network.mtu' '1500')

    # DNS 서버 (JSON 배열 형식으로 변환)
    dns_servers=$(get_config '.network.dns[]' '8.8.8.8' | while read -r dns; do echo "\"$dns\""; done | paste -sd ',' -)

    # 스펙 정보
    local num_cpus memory_mb disk_gb
    num_cpus=$(get_spec ".vm_specs.$spec.cpu" "2")
    memory_mb=$(get_spec ".vm_specs.$spec.memory_mb" "4096")
    disk_gb=$(get_spec ".vm_specs.$spec.disk_gb" "50")

    # 고급 옵션: 추가 디스크/네트워크 → HCL 리스트 문자열
    local extra_disks_hcl="[]"
    if (( ${#EXTRA_DISKS[@]} > 0 )); then
        local entries="" d size mode
        for d in "${EXTRA_DISKS[@]}"; do
            size="${d%%:*}"
            mode="${d##*:}"
            entries+="{ size = $size, mode = \"$mode\" }, "
        done
        extra_disks_hcl="[${entries%, }]"
    fi

    local extra_networks_hcl="[]"
    if (( ${#EXTRA_NICS[@]} > 0 )); then
        local pgs="" n pg
        for n in "${EXTRA_NICS[@]}"; do
            pg=$(get_network_port_group "$n")
            pgs+="\"$pg\", "
        done
        extra_networks_hcl="[${pgs%, }]"
    fi

    # SSH 키
    local ssh_public_key
    ssh_public_key=$(get_user_ssh_key "$user")

    # 타임스탬프
    local timestamp
    timestamp=$(get_timestamp)

    # vSphere VM 이름 (사용자 프리픽스 포함 - vSphere에서 고유해야 함)
    local vsphere_vm_name="${user}-${vm_name}"

    # 변수 치환
    sed -e "s|\${VM_NAME}|$vm_name|g" \
        -e "s|\${VSPHERE_VM_NAME}|$vsphere_vm_name|g" \
        -e "s|\${USER}|$user|g" \
        -e "s|\${TIMESTAMP}|$timestamp|g" \
        -e "s|\${VSPHERE_SERVER}|$vsphere_server|g" \
        -e "s|\${VSPHERE_ALLOW_UNVERIFIED_SSL}|true|g" \
        -e "s|\${DATACENTER}|$datacenter|g" \
        -e "s|\${CLUSTER}|$cluster|g" \
        -e "s|\${DATASTORE}|$datastore|g" \
        -e "s|\${NETWORK}|$network|g" \
        -e "s|\${RESOURCE_POOL}|$resource_pool|g" \
        -e "s|\${VM_FOLDER}|$vm_folder|g" \
        -e "s|\${CONTENT_LIBRARY}|$content_library|g" \
        -e "s|\${LIBRARY_ITEM}|$library_item|g" \
        -e "s|\${GUEST_ID}|$guest_id|g" \
        -e "s|\${FIRMWARE}|$firmware|g" \
        -e "s|\${DEFAULT_USER}|$default_user|g" \
        -e "s|\${INTERFACE}|$interface|g" \
        -e "s|\${NUM_CPUS}|$num_cpus|g" \
        -e "s|\${MEMORY_MB}|$memory_mb|g" \
        -e "s|\${DISK_GB}|$disk_gb|g" \
        -e "s|\${IP_ADDRESS}|$ip_address|g" \
        -e "s|\${NETMASK}|$netmask|g" \
        -e "s|\${GATEWAY}|$gateway|g" \
        -e "s|\${DNS_SERVERS}|$dns_servers|g" \
        -e "s|\${NETWORK_PREFIX}|$network_prefix|g" \
        -e "s|\${MTU}|$mtu|g" \
        -e "s|\${SSH_PUBLIC_KEY}|$ssh_public_key|g" \
        -e "s|\${EXTRA_DISKS}|$extra_disks_hcl|g" \
        -e "s|\${EXTRA_NETWORKS}|$extra_networks_hcl|g" \
        -e "s|\${ADMIN_USER}|$CONSOLE_ADMIN_USER|g" \
        -e "s|\${ADMIN_PASSWORD_HASH}|$ADMIN_PASSWORD_HASH|g" \
        "$template_file" > "$output_dir/main.tf"
}

# 콘솔 관리자 비번 생성 → 해시는 ADMIN_PASSWORD_HASH 전역에 설정, 평문은 root 전용 파일에 저장
# 성공 시 0, 실패 시 1
setup_console_password() {
    local user="$1"
    local vm_name="$2"

    local plain salt hash
    plain=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)
    salt=$(tr -dc 'A-Za-z0-9./' < /dev/urandom | head -c 16)
    hash=$(openssl passwd -6 -salt "$salt" "$plain" 2>/dev/null)

    if [[ -z "$hash" ]]; then
        echo "{\"error\": \"Failed to hash console password\"}" >&2
        return 1
    fi

    # 평문 저장 (root 전용)
    local pw_dir="$CONSOLE_PW_DIR/$user"
    mkdir -p "$pw_dir"
    chmod 700 "$CONSOLE_PW_DIR" "$pw_dir"
    local pw_file="$pw_dir/${vm_name}.txt"
    printf '%s\n' "$plain" > "$pw_file"
    chmod 600 "$pw_file"
    chown root:root "$pw_file" 2>/dev/null || true

    ADMIN_PASSWORD_HASH="$hash"
    return 0
}

# VM 생성 실행 (API 모드 - Terraform 직접 실행)
create_single_vm_api_mode() {
    local vm_name="$1"
    local os_type="$2"
    local spec="$3"
    local user="$4"

    # Terraform 디렉토리
    local tf_dir="$BASPHERE_DATA_DIR/terraform/$user/$vm_name"

    # 이미 존재하는지 확인
    if [[ -d "$tf_dir" ]]; then
        echo "{\"error\": \"VM already exists: $vm_name\"}" >&2
        return 1
    fi

    # IP 할당
    local ip_address
    if ! ip_address=$("$INTERNAL_SCRIPTS/allocate-ip" "$user" "$vm_name" "vm" 2>/dev/null); then
        echo "{\"error\": \"IP allocation failed\"}" >&2
        return 1
    fi

    # Terraform 디렉토리 생성
    mkdir -p "$tf_dir"

    # 콘솔 관리자 비번 생성 (해시는 렌더링에 사용, 평문은 root 전용 저장)
    local pw_file="$CONSOLE_PW_DIR/$user/${vm_name}.txt"
    if ! setup_console_password "$user" "$vm_name"; then
        "$INTERNAL_SCRIPTS/release-ip" "$ip_address" "$user" 2>/dev/null || true
        rm -rf "$tf_dir"
        return 1
    fi

    # Terraform 파일 생성
    if ! generate_terraform_file "$vm_name" "$os_type" "$spec" "$ip_address" "$user" "$tf_dir"; then
        # 실패 시 IP 반환
        "$INTERNAL_SCRIPTS/release-ip" "$ip_address" "$user" 2>/dev/null || true
        rm -f "$pw_file"
        rm -rf "$tf_dir"
        return 1
    fi

    # vSphere VM 이름 (사용자 프리픽스 포함)
    local vsphere_vm_name="${user}-${vm_name}"
    local login_user
    login_user=$(get_os_default_user "$os_type")

    # 고급 옵션 메타데이터 (JSON 배열)
    local extra_disks_json="[]" extra_networks_json="[]"
    if (( ${#EXTRA_DISKS[@]} > 0 )); then
        extra_disks_json=$(printf '%s\n' "${EXTRA_DISKS[@]}" | \
            jq -R 'split(":") | {size_gb: (.[0] | tonumber), mode: .[1]}' | jq -s -c '.')
    fi
    if (( ${#EXTRA_NICS[@]} > 0 )); then
        extra_networks_json=$(printf '%s\n' "${EXTRA_NICS[@]}" | jq -R '.' | jq -s -c '.')
    fi

    # 메타데이터 생성
    local created_at
    created_at=$(get_timestamp)
    cat > "$tf_dir/metadata.json" << EOF
{
    "name": "$vm_name",
    "vsphere_vm_name": "$vsphere_vm_name",
    "owner": "$user",
    "os": "$os_type",
    "login_user": "$login_user",
    "spec": "$spec",
    "ip_address": "$ip_address",
    "extra_disks": $extra_disks_json,
    "extra_networks": $extra_networks_json,
    "created_at": "$created_at",
    "status": "creating"
}
EOF

    # vSphere 인증 정보 파일 확인
    if [[ ! -f "$BASPHERE_VSPHERE_ENV" ]]; then
        echo "{\"error\": \"vSphere credentials not found\"}" >&2
        "$INTERNAL_SCRIPTS/release-ip" "$ip_address" "$user" 2>/dev/null || true
        rm -f "$pw_file"
        rm -rf "$tf_dir"
        return 1
    fi

    # Terraform 실행 (서브쉘 내에서 환경변수 로드)
    (
        cd "$tf_dir"

        # 환경변수 로드
        set -a
        source "$BASPHERE_VSPHERE_ENV"
        set +a

        # terraform init
        if ! terraform init -no-color > terraform-init.log 2>&1; then
            exit 1
        fi

        # terraform apply
        if ! terraform apply -auto-approve -no-color > terraform-apply.log 2>&1; then
            exit 1
        fi
    )

    if [[ $? -ne 0 ]]; then
        # 실패 시 정리
        jq '.status = "failed"' "$tf_dir/metadata.json" > "$tf_dir/metadata.json.tmp" && \
            mv "$tf_dir/metadata.json.tmp" "$tf_dir/metadata.json"
        echo "{\"error\": \"Terraform apply failed\"}" >&2
        return 1
    fi

    # 성공 - 메타데이터 업데이트
    jq '.status = "running"' "$tf_dir/metadata.json" > "$tf_dir/metadata.json.tmp" && \
        mv "$tf_dir/metadata.json.tmp" "$tf_dir/metadata.json"

    # 감사 로그
    audit_log "CREATE_VM" "$vm_name" "user=$user,os=$os_type,spec=$spec,ip=$ip_address,extra_disks=${#EXTRA_DISKS[@]},extra_networks=${#EXTRA_NICS[@]}"

    # JSON 출력 (API 모드)
    cat "$tf_dir/metadata.json"
    return 0
}

# 일반 모드 - API를 통한 VM 생성
create_vm_via_api() {
    local vm_name="$1"
    local os_type="$2"
    local spec="$3"
    local count="$4"

    # API 연결 확인
    if ! check_api_connection; then
        exit 1
    fi

    # 고급 옵션 JSON 배열
    local extra_disks_json="[]" extra_networks_json="[]"
    if (( ${#EXTRA_DISKS[@]} > 0 )); then
        extra_disks_json=$(printf '%s\n' "${EXTRA_DISKS[@]}" | \
            jq -R 'split(":") | {size_gb: (.[0] | tonumber), mode: .[1]}' | jq -s -c '.')
    fi
    if (( ${#EXTRA_NICS[@]} > 0 )); then
        extra_networks_json=$(printf '%s\n' "${EXTRA_NICS[@]}" | jq -R '.' | jq -s -c '.')
    fi

    # JSON 데이터 생성
    local json_data
    json_data=$(jq -n \
        --arg name "$vm_name" \
        --arg os "$os_type" \
        --arg spec "$spec" \
        --argjson count "$count" \
        --argjson extra_disks "$extra_disks_json" \
        --argjson extra_networks "$extra_networks_json" \
        '{name: $name, os: $os, spec: $spec, count: $count,
          extra_disks: $extra_disks, extra_networks: $extra_networks}')

    log_info "VM 생성 요청 중..."

    # API 호출
    local response
    response=$(api_call "POST" "/api/v1/vms" "$json_data")

    # 응답 파싱
    local success
    success=$(api_check_success "$response")

    # 성공/부분성공/전체실패 모두 .data에 created/failed/errors가 담겨 옴
    local created failed
    created=$(echo "$response" | jq -r '.data.created // 0')
    failed=$(echo "$response" | jq -r '.data.failed // 0')

    echo ""
    echo "=========================================="
    echo "생성 완료: $created / $count"
    if [[ "$failed" -gt 0 ]]; then
        echo "실패: $failed"
    fi
    echo "=========================================="

    # 생성된 VM 정보 출력
    echo "$response" | jq -r '.data.vms[]? | "  - \(.name): \(.ip_address) (\(.status))"'

    # 실패 사유 출력 (있으면)
    if [[ "$failed" -gt 0 ]] || [[ "$success" != "true" ]]; then
        local errors
        errors=$(echo "$response" | jq -r '.data.errors[]?' 2>/dev/null)
        if [[ -n "$errors" ]]; then
            echo ""
            log_error "실패 사유:"
            while IFS= read -r line; do
                [[ -n "$line" ]] && echo "  - $line"
            done <<< "$errors"
        else
            # errors 배열이 없으면 상위 메시지라도 표시
            local error_msg
            error_msg=$(api_get_error "$response")
            [[ -n "$error_msg" ]] && log_error "VM 생성 실패: $error_msg"
        fi
    fi

    if [[ "$created" -gt 0 ]]; then
        echo ""
        echo "VM 접속: ssh <login_user>@<IP_ADDRESS>"
        echo "VM 목록: list-vms"
    fi

    # 하나라도 실패하면 비정상 종료 코드
    [[ "$failed" -eq 0 && "$success" == "true" ]]
}

# 메인 함수
main() {
    local vm_name=""
    local os_type=""
    local spec=""
    local count=1
    local api_mode=false
    local target_user=""
    local extra_disk_args=()
    local extra_nic_args=()

    # 인자 파싱
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--name)
                vm_name="$2"
                shift 2
                ;;
            -o|--os)
                os_type="$2"
                shift 2
                ;;
            -s|--spec)
                spec="$2"
                shift 2
                ;;
            -c|--count)
                count="$2"
                shift 2
                ;;
            --disk)
                extra_disk_args+=("$2")
                shift 2
                ;;
            --nic)
                extra_nic_args+=("$2")
                shift 2
                ;;
            --api)
                api_mode=true
                shift
                ;;
            --user)
                target_user="$2"
                shift 2
                ;;
            -h|--help)
                usage
                ;;
            *)
                log_error "알 수 없는 옵션: $1"
                usage
                ;;
        esac
    done

    # 고급 옵션 플래그 정규화 (SIZE → SIZE:auto)
    local d
    for d in "${extra_disk_args[@]}"; do
        [[ "$d" == *:* ]] || d="${d}:auto"
        EXTRA_DISKS+=("$d")
    done
    EXTRA_NICS=("${extra_nic_args[@]}")

    # API 모드: Terraform 직접 실행 (API 서버에서 호출)
    if [[ "$api_mode" == "true" ]]; then
        local user="${target_user:-$CURRENT_USER}"

        if [[ -z "$vm_name" || -z "$os_type" || -z "$spec" ]]; then
            echo "{\"error\": \"Missing required parameters: name, os, spec\"}" >&2
            exit 1
        fi

        if ! validate_extra_options; then
            echo "{\"error\": \"Invalid extra options\"}" >&2
            exit 1
        fi

        if create_single_vm_api_mode "$vm_name" "$os_type" "$spec" "$user"; then
            exit 0
        else
            exit 1
        fi
    fi

    # 일반 모드: 사용자 대화형 입력 후 API 호출

    # 사용자 확인
    if ! user_exists "$CURRENT_USER"; then
        log_error "Basphere 사용자가 아닙니다: $CURRENT_USER"
        log_info "관리자에게 계정 생성을 요청하세요"
        exit 1
    fi

    echo ""
    echo "=== VM 생성 ==="
    echo ""

    # 1. VM 이름 입력
    if [[ -z "$vm_name" ]]; then
        vm_name=$(prompt_input "VM 이름")

        if ! validate_resource_name "$vm_name"; then
            exit 1
        fi
    fi

    # 이름 중복 확인 (로컬 체크)
    if vm_name_exists "$CURRENT_USER" "$vm_name"; then
        log_error "이미 존재하는 VM 이름입니다: $vm_name"
        exit 1
    fi

    # 2. OS 선택 (필수)
    if [[ -z "$os_type" ]]; then
        echo ""
        local os_list
        os_list=$(get_os_list)

        if [[ -z "$os_list" ]]; then
            log_error "사용 가능한 OS가 설정되지 않았습니다"
            log_info "관리자에게 문의하세요"
            exit 1
        fi

        local os_array=()
        while IFS= read -r os; do
            [[ -n "$os" ]] && os_array+=("$os")
        done <<< "$os_list"

        local os_options=()
        for os in "${os_array[@]}"; do
            local desc
            desc=$(get_os_description "$os")
            os_options+=("$desc")
        done

        local os_selection
        os_selection=$(prompt_select "OS 선택" "${os_options[@]}")
        os_type="${os_array[$os_selection]}"
    else
        # 명령행에서 OS 지정 시 유효성 검사
        if ! validate_os "$os_type"; then
            log_error "지원하지 않는 OS입니다: $os_type"
            log_info "사용 가능한 OS: $(get_os_list | tr '\n' ' ')"
            exit 1
        fi
    fi

    # 3. 스펙 선택
    if [[ -z "$spec" ]]; then
        echo ""
        local specs_list
        specs_list=$(get_vm_specs)
        local specs_array=($specs_list)

        local options=()
        for s in "${specs_array[@]}"; do
            local details
            details=$(get_spec_details "$s")
            options+=("$s - $details")
        done

        local selection
        selection=$(prompt_select "스펙 선택" "${options[@]}")
        spec="${specs_array[$selection]}"
    fi

    # 4. 대수 입력
    if [[ $count -eq 1 ]]; then
        echo ""
        count=$(prompt_number "생성할 VM 대수" 1 1 10)
    fi

    # 5. 고급 옵션 (플래그로 지정하지 않은 경우 대화형)
    if (( ${#EXTRA_DISKS[@]} == 0 && ${#EXTRA_NICS[@]} == 0 )); then
        echo ""
        if prompt_confirm "고급 옵션을 설정하시겠습니까? (디스크/네트워크 추가)" "n"; then
            # 추가 디스크
            local max_disks min_gb max_gb
            max_disks=$(get_spec ".custom_options.extra_disks.max_count" "3")
            min_gb=$(get_spec ".custom_options.extra_disks.min_gb" "10")
            max_gb=$(get_spec ".custom_options.extra_disks.max_gb" "500")

            echo ""
            echo "[추가 디스크] (최대 ${max_disks}개, 개당 ${min_gb}~${max_gb}GB)"
            local disk_count
            disk_count=$(prompt_number "추가 디스크 개수" 0 0 "$max_disks")

            local i size mode_sel
            for ((i = 1; i <= disk_count; i++)); do
                size=$(prompt_number "디스크 $i 크기 (GB)" "$min_gb" "$min_gb" "$max_gb")
                mode_sel=$(prompt_select "디스크 $i 처리 방식" \
                    "자동 포맷 + /data$i 마운트 (ext4)" \
                    "Raw (직접 포맷)")
                if [[ "$mode_sel" == "0" ]]; then
                    EXTRA_DISKS+=("${size}:auto")
                else
                    EXTRA_DISKS+=("${size}:raw")
                fi
            done

            # 추가 네트워크 (카탈로그가 비어있으면 섹션 생략)
            local catalog=()
            local cat_entry
            while IFS= read -r cat_entry; do
                [[ -n "$cat_entry" ]] && catalog+=("$cat_entry")
            done < <(get_network_catalog)

            if (( ${#catalog[@]} > 0 )); then
                echo ""
                echo "[추가 네트워크] (IP는 게스트에서 직접 설정)"
                local nic_options=("없음")
                local n
                for n in "${catalog[@]}"; do
                    nic_options+=("$n - $(get_network_catalog_description "$n")")
                done
                local nic_sel
                nic_sel=$(prompt_select "추가 네트워크 연결" "${nic_options[@]}")
                if [[ "$nic_sel" != "0" ]]; then
                    EXTRA_NICS+=("${catalog[$((nic_sel - 1))]}")
                fi
            fi
        fi
    fi

    # 고급 옵션 검증 (한도/카탈로그 - 플래그 입력 포함)
    if ! validate_extra_options; then
        exit 1
    fi

    # 확인
    echo ""
    echo "생성할 VM 정보:"
    echo "  - 이름: $vm_name"
    echo "  - OS: $os_type ($(get_os_description "$os_type"))"
    echo "  - 스펙: $spec ($(get_spec_details "$spec"))"
    echo "  - 대수: $count"
    if (( ${#EXTRA_DISKS[@]} > 0 )); then
        local disk_idx=1 disk_entry disk_size disk_mode
        for disk_entry in "${EXTRA_DISKS[@]}"; do
            disk_size="${disk_entry%%:*}"
            disk_mode="${disk_entry##*:}"
            if [[ "$disk_mode" == "auto" ]]; then
                echo "  + 추가 디스크 $disk_idx: ${disk_size}GB (자동 마운트 /data$disk_idx)"
            else
                echo "  + 추가 디스크 $disk_idx: ${disk_size}GB (raw)"
            fi
            disk_idx=$((disk_idx + 1))
        done
    fi
    if (( ${#EXTRA_NICS[@]} > 0 )); then
        echo "  + 추가 네트워크: ${EXTRA_NICS[*]} (IP 미설정)"
    fi
    echo ""

    if ! prompt_confirm "VM을 생성하시겠습니까?" "y"; then
        log_info "취소되었습니다"
        exit 0
    fi

    echo ""

    # API를 통해 VM 생성
    create_vm_via_api "$vm_name" "$os_type" "$spec" "$count"
}

main "$@"
