# Basphere CLI Configuration
# 이 파일을 /etc/basphere/config.yaml로 복사하고 환경에 맞게 수정하세요.

# vSphere 환경 설정
vsphere:
  server: "vcenter.example.local"        # vCenter 서버 주소
  datacenter: "DC1"                       # 데이터센터 이름
  cluster: "Cluster1"                     # 클러스터 이름
  datastore: "datastore1"                 # 데이터스토어 이름
  resource_pool: ""                       # 리소스 풀 경로 (비워두면 클러스터 기본 풀 사용)
  network: "VM Network"                   # VM 네트워크 (포트그룹 이름)
  folder: "basphere-vms"                  # VM 폴더 (없으면 자동 생성)

# VM 이미지 설정 (컨텐츠 라이브러리 기반)
# OS 이미지는 vCenter 컨텐츠 라이브러리의 OVF 아이템 (cloud-init 포함 필수)
# - library: 라이브러리 이름
# - library_item: 아이템 이름 (버전+빌드날짜 포함 권장, 예: ubuntu-24.04-20260705-...)
# - guest_id: vSphere 게스트 OS 식별자 (govc vm.option.info로 확인)
# - firmware: bios 또는 efi (이미지 부팅 방식에 맞출 것)
# - interface: 게스트가 인식하는 NIC 이름 (vmxnet3 기준 보통 ens192)
templates:
  library: "os-content-library"
  hardware_version: 21                    # 가상 하드웨어 버전 (21 = ESXi 8.0). 클라우드 OVA의 낮은 버전을 상향
  os:
    ubuntu-24.04:
      library_item: "ubuntu-24.04-20260705-server-cloudimg-amd64"
      default_user: "ubuntu"
      description: "Ubuntu 24.04 LTS (Noble)"
      interface: "ens192"
      guest_id: "ubuntu64Guest"
      firmware: "bios"
    rocky-10.2:
      library_item: "rocky-10.2-20260525-r2"
      default_user: "rocky"
      description: "Rocky Linux 10.2"
      interface: "ens33"
      guest_id: "rockylinux_64Guest"
      firmware: "efi"
    # 다른 OS 추가 예시:
    # rhel-10.2:
    #   library_item: "rhel-10.2-20260720"
    #   default_user: "cloud-user"
    #   description: "Red Hat Enterprise Linux 10.2"
    #   interface: "ens33"
    #   guest_id: "rhel9_64Guest"
    #   firmware: "efi"

# 네트워크 설정
network:
  cidr: "10.254.0.0/21"                   # 전체 네트워크 대역
  gateway: "10.254.0.1"                   # 게이트웨이
  netmask: "255.255.248.0"                # 서브넷 마스크 (/21)
  prefix_length: 21                        # CIDR prefix
  mtu: 1500                                # MTU 크기 (오버레이 네트워크는 1450)
  dns:
    - "8.8.8.8"
    - "1.1.1.1"
  # 사용자당 IP 블록 크기 (32 = /27)
  block_size: 32
  # 예약된 IP (할당하지 않음)
  reserved:
    - "10.254.0.1"   # Gateway
    - "10.254.0.2"   # Reserved
    - "10.254.0.3"   # Reserved

# Management 클러스터 설정 (Cluster API용 - Stage 2에서 사용)
management_cluster:
  kubeconfig: "/etc/basphere/management-kubeconfig"
  namespace_prefix: "user-"

# 사용자 기본 할당량
quotas:
  default:
    max_vms: 10                           # 최대 VM 수
    max_clusters: 3                       # 최대 클러스터 수
    max_ips: 32                           # 최대 IP 수 (블록 크기와 동일)

# 디렉토리 경로
paths:
  data: "/var/lib/basphere"               # 데이터 디렉토리
  logs: "/var/log/basphere"               # 로그 디렉토리
  config: "/etc/basphere"                 # 설정 디렉토리

# 로깅 설정
logging:
  level: "info"                           # debug, info, warn, error
  audit_enabled: true                     # 감사 로깅 활성화

# 추가 네트워크 카탈로그 (create-vm 고급 옵션에서 선택 가능한 포트그룹)
# key: 사용자에게 표시되는 이름 / port_group: vSphere 포트그룹 이름
# IP는 설정하지 않고 링크만 연결됨 (게스트에서 직접 설정)
extra_network_catalog: {}
# extra_network_catalog:
#   98-air-gapped:
#     port_group: "98-air-gapped"
#     description: "폐쇄망 (IP 미설정, 링크만 연결)"
